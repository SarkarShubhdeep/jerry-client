# Jerry CLI — copy to jerry-cli/.env for local dev (optional)

# API key can live in ~/.config/jerry/cli.json instead:
#   jerry config set openai-api-key

# Optional env overrides (take precedence over cli.json)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ACTIVITYWATCH_BASE_URL=http://localhost:5600/api/0
# JERRY_REPORTS_DIR=~/Documents/jerry-reports
