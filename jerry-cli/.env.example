# Example environment variables for jerry-cli

# Required for LLM features (ask, report)
OPENAI_API_KEY=sk-...

# Optional: Override OpenAI model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Optional: Override reports output directory
# JERRY_REPORTS_DIR=~/Documents/jerry-reports

# Optional: Override ActivityWatch API base URL
# ACTIVITYWATCH_BASE_URL=http://localhost:5600/api/0

# Optional: Override XDG config directory
# XDG_CONFIG_HOME=~/.config
