{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "../dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@sarkarshubhdeep/jerry-lib": ["../node_modules/@sarkarshubhdeep/jerry-lib/_dist/mod.d.ts"]
    }
  },
  "include": ["./**/*.ts"]
}
